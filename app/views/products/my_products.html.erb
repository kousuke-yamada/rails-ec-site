<% content_for :title, "出品した商品一覧" %>

<%= content_for :head do %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'mercari': {
              50: '#fef2f2',
              100: '#fee2e2',
              200: '#fecaca',
              300: '#fca5a5',
              400: '#f87171',
              500: '#ea352d',
              600: '#dc2626',
              700: '#b91c1c',
              800: '#991b1b',
              900: '#7f1d1d',
            }
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-out',
            'slide-up': 'slideUp 0.3s ease-out',
            'scale-in': 'scaleIn 0.2s ease-out',
          }
        }
      }
    }
  </script>
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    
    .glass-morphism {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .section-enter {
      animation: fade-in 0.6s ease-out;
    }
    
    .interactive-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .interactive-hover:hover {
      transform: translateY(-2px);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }
  </style>
<% end %>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-100">
  <!-- Header -->
  <header class="sticky top-0 z-50 glass-morphism shadow-lg">
    <div class="max-w-6xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-6">
          <%= link_to root_path, class: "text-3xl font-black text-mercari-500 tracking-tight no-underline" do %>
            mercari
          <% end %>
          <div class="hidden md:flex items-center space-x-2 text-sm font-medium text-gray-600">
            <%= link_to "ホーム", root_path, class: "hover:text-mercari-500 cursor-pointer transition-colors no-underline text-gray-600" %>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
            <span class="text-mercari-500">出品した商品</span>
          </div>
        </div>
        <div class="hidden md:block">
          <div class="px-4 py-2 bg-mercari-50 text-mercari-700 rounded-full text-sm font-semibold">
            商品管理
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Hero Section -->
    <div class="text-center mb-16 section-enter">
      <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight">
        出品した<span class="text-mercari-500">商品</span>一覧
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        あなたが出品した商品を管理できます（<%= @products.count %>件）
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="mb-12 section-enter" style="animation-delay: 0.2s">
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <%= link_to listing_products_path, class: "bg-gradient-to-r from-mercari-500 to-mercari-600 text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 no-underline flex items-center" do %>
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          新しい商品を出品する
        <% end %>
        
        <%= link_to "/mypage", class: "bg-white text-gray-700 border-2 border-gray-200 px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-all duration-300 hover:scale-105 no-underline flex items-center" do %>
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          マイページに戻る
        <% end %>
      </div>
    </div>

    <% if @products.any? %>
      <!-- Products Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 section-enter" style="animation-delay: 0.4s">
        <% @products.each_with_index do |product, index| %>
          <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden interactive-hover cursor-pointer animate-scale-in" 
               style="animation-delay: <%= index * 0.1 %>s"
               onclick="location.href='<%= product_path(product) %>'">
            
            <!-- Product Image -->
            <div class="relative h-64 bg-gradient-to-br from-gray-100 to-gray-200 overflow-hidden">
              <% if product.images.any? %>
                <%= image_tag product.images.first, 
                             alt: product.name, 
                             class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-6xl text-gray-400">📷</span>
                </div>
              <% end %>
              
              <!-- Status Badge -->
              <div class="absolute top-4 right-4">
                <% if product.respond_to?(:sold?) && product.sold? %>
                  <span class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                    売却済み
                  </span>
                <% else %>
                  <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                    出品中
                  </span>
                <% end %>
              </div>
              
              <!-- Category Badge -->
              <div class="absolute top-4 left-4">
                <% if product.category_id.present? %>
                  <span class="bg-white bg-opacity-90 text-gray-700 px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
                    <%= get_category_name(product.category_id) %>
                  </span>
                <% end %>
              </div>
            </div>
            
            <!-- Product Info -->
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2 leading-tight">
                <%= product.name %>
              </h3>
              
              <div class="text-2xl font-black text-mercari-500 mb-4">
                ¥<%= number_with_delimiter(product.price.to_i) %>
              </div>
              
              <% if product.description.present? %>
                <p class="text-sm text-gray-600 mb-4 line-clamp-2 leading-relaxed">
                  <%= truncate(product.description, length: 80) %>
                </p>
              <% end %>
              
              <!-- Product Details -->
              <div class="space-y-2 mb-4">
                <% if product.condition_id.present? %>
                  <div class="flex items-center text-xs text-gray-500">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-medium">状態:</span>
                    <span class="ml-1"><%= get_condition_name(product.condition_id) %></span>
                  </div>
                <% end %>
                
                <% if product.prefecture_id.present? %>
                  <div class="flex items-center text-xs text-gray-500">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-medium">発送元:</span>
                    <span class="ml-1"><%= get_prefecture_name(product.prefecture_id) %></span>
                  </div>
                <% end %>
              </div>
              
              <!-- Footer -->
              <div class="flex justify-between items-center pt-4 border-t border-gray-100">
                <span class="text-xs text-gray-500 font-medium">
                  <%= product.created_at.strftime("%Y/%m/%d") %>
                </span>
                
                <!-- Action Buttons -->
                <div class="flex space-x-2">
                  <%= link_to edit_product_path(product), 
                             class: "text-blue-500 hover:text-blue-700 transition-colors p-2 hover:bg-blue-50 rounded-lg",
                             title: "編集",
                             onclick: "event.stopPropagation();" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  <% end %>
                  
                  <%= link_to product_path(product), 
                             method: :delete,
                             class: "text-red-500 hover:text-red-700 transition-colors p-2 hover:bg-red-50 rounded-lg",
                             title: "削除",
                             onclick: "event.stopPropagation(); return confirm('本当に削除しますか？');",
                             data: { confirm: "本当に削除しますか？" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination (if needed) -->
      <% if @products.respond_to?(:current_page) %>
        <div class="mt-16 flex justify-center">
          <%= paginate @products, theme: 'twitter_bootstrap_4' %>
        </div>
      <% end %>
      
    <% else %>
      <!-- Empty State -->
      <div class="section-enter" style="animation-delay: 0.4s">
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-16 text-center">
          <div class="animate-float mb-8">
            <div class="text-8xl mb-6">📦</div>
          </div>
          <h3 class="text-3xl font-bold text-gray-900 mb-4">まだ商品を出品していません</h3>
          <p class="text-gray-600 text-lg mb-8 leading-relaxed">
            最初の商品を出品して、販売を始めましょう！<br>
            簡単なステップであなたの商品を世界中の人に届けることができます。
          </p>
          
          <%= link_to listing_products_path, class: "bg-gradient-to-r from-mercari-500 to-mercari-600 text-white px-12 py-5 rounded-2xl font-black text-xl shadow-2xl hover:shadow-3xl transition-all duration-300 hover:scale-105 no-underline inline-flex items-center" do %>
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            商品を出品する
          <% end %>
          
          <div class="mt-12 bg-gradient-to-r from-gray-50 to-gray-100 rounded-2xl p-8 text-left">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0">
                <svg class="w-8 h-8 text-mercari-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-sm text-gray-700 space-y-3">
                <p class="font-semibold text-gray-900 text-base">出品のコツ</p>
                <ul class="space-y-2 text-gray-600">
                  <li class="flex items-start">
                    <span class="text-mercari-500 mr-2">•</span>
                    <span>魅力的な写真を複数枚アップロードしましょう</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-mercari-500 mr-2">•</span>
                    <span>商品の状態を正確に記載しましょう</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-mercari-500 mr-2">•</span>
                    <span>適切な価格設定で売れやすくしましょう</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // アニメーション効果
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
        }
      });
    }, observerOptions);
    
    document.querySelectorAll('.section-enter').forEach(section => {
      observer.observe(section);
    });
    
    // ホバー効果の強化
    document.querySelectorAll('.interactive-hover').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-8px) scale(1.02)';
      });
      
      card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
      });
    });
  });
</script>