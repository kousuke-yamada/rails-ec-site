<%# app/views/devise/sessions/new.html.erb %>

<div class="bg-gray-50 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-8 whitespace-nowrap">TANITSUBO—YAMA</h1>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-4">
                <%= f.label :email, "メールアドレス", class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", required: true %>
            </div>

            <div class="mb-6">
                <%= f.label :password, "パスワード", class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= f.password_field :password, autocomplete: "current-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline", required: true %>
            </div>

            <% if devise_mapping.rememberable? %>
                <div class="flex items-center justify-center mb-4">
                    <%= f.check_box :remember_me, class: "mr-2" %>
                    <%= f.label :remember_me, "Remember me", class: "text-sm text-gray-700" %>
                </div>
            <% end %>

            <div class="mb-12">
                <%= f.submit "ログイン", class: "w-full bg-black text-white py-3 px-4 rounded-md font-medium hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200" %>
            </div>
        <% end %>

        <div class="text-center mt-8 mb-6">
            <button id="openSignupModal" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-md transition duration-200">
                新規アカウント作成
            </button>
        </div>

        <div class="text-center">
            <a href="#" class="inline-block px-6 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition duration-200">
                問い合わせ
            </a>
        </div>
    </div>

    <!-- 新規登録モーダルウィンドウ -->
    <div id="signupModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden flex items-center justify-center z-50">
        <div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md relative">
            <button id="closeSignupModal" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl font-bold">&times;</button>
            <h2 class="text-2xl font-bold mb-6 text-center text-gray-900">新規アカウント作成</h2>

            <%= form_for(User.new, as: resource_name, url: registration_path(resource_name), html: { id: "signupForm" }) do |f| %>
                <div id="signupErrors" class="text-red-500 mb-4 text-sm"></div>

                <div class="mb-4">
                    <%= f.label :name, "名前", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.text_field :name, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500", required: true %>
                </div>

                <div class="mb-4">
                    <%= f.label :email, "メールアドレス", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.email_field :email, autocomplete: "email", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500", required: true %>
                </div>

                <div class="mb-4">
                    <%= f.label :phone, "電話番号", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.text_field :phone, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500", placeholder: "例: 09012345678" %>
                </div>

                <div class="mb-4">
                    <%= f.label :password, "パスワード", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <p class="text-xs text-gray-500 mb-2">
                        <% if @minimum_password_length %>
                            （<%= @minimum_password_length %>文字以上）
                        <% end %>
                    </p>
                    <%= f.password_field :password, autocomplete: "new-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500", required: true %>
                </div>

                <div class="mb-6">
                    <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500", required: true %>
                </div>

                <div class="text-center">
                    <%= f.submit "登録", class: "w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-200" %>
                </div>
            <% end %>
        </div>
    </div>
</div>

<script>
// モーダル制御関数（Turbo対応）
function initializeSignupModal() {
    const openModal = document.getElementById('openSignupModal');
    const closeModal = document.getElementById('closeSignupModal');
    const modal = document.getElementById('signupModal');

    if (openModal && modal) {
        // 重複防止のため既存のイベントリスナーを削除
        openModal.replaceWith(openModal.cloneNode(true));
        const newOpenModal = document.getElementById('openSignupModal');
        
        newOpenModal.addEventListener('click', function(e) {
            e.preventDefault();
            modal.classList.remove('hidden');
        });
    }

    if (closeModal && modal) {
        closeModal.replaceWith(closeModal.cloneNode(true));
        const newCloseModal = document.getElementById('closeSignupModal');
        
        newCloseModal.addEventListener('click', function(e) {
            e.preventDefault();
            modal.classList.add('hidden');
        });
    }

    if (modal) {
        // モーダル背景クリックで閉じる
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.classList.add('hidden');
            }
        });
    }

    // ESCキーで閉じる（グローバル）
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const currentModal = document.getElementById('signupModal');
            if (currentModal && !currentModal.classList.contains('hidden')) {
                currentModal.classList.add('hidden');
            }
        }
    });
}

// 初期読み込み時とTurbo読み込み時の両方で実行
document.addEventListener('DOMContentLoaded', initializeSignupModal);
document.addEventListener('turbo:load', initializeSignupModal);
document.addEventListener('turbo:render', initializeSignupModal);
</script>