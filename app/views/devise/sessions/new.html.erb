<%# app/views/devise/sessions/new.html.erb %>

<body class="bg-gray-50 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md"> <%# フォームとロゴを中央に配置するためのラッパー %>
        <div class="text-center mb-8">
            <h1 class="text-5xl font-bold text-gray-900 mb-15">TANITSUBO—YAMA</h1>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %> <%# エラーメッセージ表示 %>

            <div class="mb-4 text-center">
                <%= f.label :email, "メールアドレス", class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", required: true %>
            </div>

            <div class="mb-6 text-center">
                <%= f.label :password, "パスワード", class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= f.password_field :password, autocomplete: "current-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline", required: true %>
            </div>

            <% if devise_mapping.rememberable? %>
                <div class="field text-center">
                    <%= f.check_box :remember_me %>
                    <%= f.label :remember_me %>
                </div>
            <% end %>

            <div class="actions">
                <%= f.submit "ログイン", class: "w-full bg-black text-white py-3 px-4 rounded-md font-medium hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200" %>
            </div>
        <% end %>

        <div class="mt-6 text-center">
            <button id="openSignupModal" class="inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition duration-200">
                新規アカウント作成
            </button>
        </div>

        <div class="mt-8 text-center">
            <a href="#" class="inline-block px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 transition duration-200">
                問い合わせ
            </a>
        </div>
    </div>

    <%# --- ここからモーダルウィンドウのHTML構造を追加 --- %>
    <div id="signupModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden flex items-center justify-center z-50">
        <div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md relative">
            <button id="closeSignupModal" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl">&times;</button>
            <h2 class="text-2xl font-bold mb-6 text-center">新規アカウント作成</h2>

            <%# 新規登録フォームをここに配置 %>
            <%= form_for(User.new, as: resource_name, url: registration_path(resource_name), html: { id: "signupForm" }) do |f| %>
                <%# エラーメッセージ表示エリア (JavaScriptで動的に更新する) %>
                <div id="signupErrors" class="text-red-500 mb-4"></div>

                <div class="mb-4">
                    <%= f.label :name, "名前:", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.text_field :name, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", required: true %>
                </div>
                <div class="mb-4">
                    <%= f.label :email, "メールアドレス:", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", required: true %>
                </div>
                <div class="mb-4">
                    <%= f.label :phone, "電話番号:", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.text_field :phone, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", placeholder: "例: 09012345678" %>
                </div>
                <div class="mb-6">
                    <%= f.label :password, "パスワード:", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <em class="text-xs text-gray-500">(<% if @minimum_password_length %><%= @minimum_password_length %> 文字以上<% end %>)</em>
                    <%= f.password_field :password, autocomplete: "new-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline", required: true %>
                </div>
                <div class="mb-6">
                    <%= f.label :password_confirmation, "パスワード（確認用）:", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline", required: true %>
                </div>

                <div class="flex items-center justify-center">
                    <%= f.submit "登録", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
                </div>
            <% end %>
        </div>
    </div>
    <%# --- モーダルウィンドウのHTML構造ここまで --- %>
</body>