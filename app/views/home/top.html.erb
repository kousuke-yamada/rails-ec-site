<!-- app/views/home/top.html.erb -->
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TANITSUBO-YAMA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- ヘッダー -->
    <header class="bg-white shadow-lg border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 py-3">
            <div class="flex items-center">
                <!-- ロゴ -->
                <div class="flex-shrink-0 mr-8">
                    <h1 class="text-2xl font-bold text-gray-900">TANITSUBO—YAMA</h1>
                </div>
                
                <!-- 検索バー -->
                <div class="flex-1 max-w-2xl mr-8">
                    <div class="relative">
                        <input 
                            type="text" 
                            placeholder="なにをお探しですか？" 
                            class="w-full border border-gray-300 rounded-md py-2 pl-4 pr-12 focus:outline-none focus:ring-2 focus:ring-black focus:border-black transition duration-200"
                        >
                        <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-800">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <!-- ナビゲーション -->
                <div class="flex items-center space-x-4">
                    <% if user_signed_in? %>
                        <!-- ログイン中の表示 -->
                        <div class="flex items-center space-x-4">
                            <span class="text-gray-700 font-medium">
                                こんにちは、<%= current_user.name %>さん
                            </span>
                            <!-- 設定ドロップダウン -->
                            <div class="relative">
                                <button id="settingsDropdownButton" class="text-gray-700 hover:text-black font-medium px-4 py-2 transition duration-200">
                                    設定
                                </button>
                                
                                <!-- ドロップダウンメニュー -->
                                <div id="settingsDropdown" class="absolute right-0 top-full mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                    <div class="py-1">
                                        <!-- マイページ -->
                                        <a href="#" class="flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100 transition duration-200">
                                            <svg class="h-4 w-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                            </svg>
                                            マイページ
                                        </a>
                                        
                                        <!-- 履歴 -->
                                        <a href="#" class="flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100 transition duration-200">
                                            <svg class="h-4 w-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            履歴
                                        </a>
                                        
                                        <!-- 区切り線 -->
                                        <hr class="my-1 border-gray-200">
                                        
                                        <!-- ログアウト -->
                                        <%= link_to destroy_user_session_path, 
                                            data: { "turbo-method": :delete, confirm: "ログアウトしますか？" },
                                            class: "flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100 transition duration-200" do %>
                                            <svg class="h-4 w-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                            </svg>
                                            ログアウト
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% else %>
                        <!-- 未ログイン時の表示 -->
                        <%= link_to "ログイン", new_user_session_path,
                            class: "text-gray-700 hover:text-black font-medium px-4 py-2 transition duration-200" %>
                    <% end %>
                    
                    <button class="bg-red-500 text-white font-medium py-2 px-6 rounded-md hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition duration-200">
                        出品
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- 設定モーダルウィンドウ -->
    <div id="settingsModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-sm relative">
            <button id="closeSettingsModal" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl">&times;</button>
            <div class="p-6">
                <h2 class="text-xl font-bold mb-6 text-center text-gray-900">設定</h2>
                
                <!-- メニューリスト -->
                <div class="space-y-3">
                    <!-- マイページ -->
                    <a href="#" class="block w-full text-left px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-md transition duration-200">
                        <div class="flex items-center">
                            <svg class="h-5 w-5 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            マイページ
                        </div>
                    </a>
                    
                    <!-- 履歴 -->
                    <a href="#" class="block w-full text-left px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-md transition duration-200">
                        <div class="flex items-center">
                            <svg class="h-5 w-5 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            履歴
                        </div>
                    </a>
                    
                    <!-- ログアウト -->
                    <%= link_to destroy_user_session_path, 
                        data: { "turbo-method": :delete, confirm: "ログアウトしますか？" },
                        class: "block w-full text-left px-4 py-3 text-gray-700 hover:bg-gray-100 rounded-md transition duration-200" do %>
                        <div class="flex items-center">
                            <svg class="h-5 w-5 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            ログアウト
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>

    <!-- メインコンテンツ -->
    <main class="max-w-7xl mx-auto px-4 py-8">
        <!-- ページタイトル -->
        <div class="mb-8">
            <h2 class="text-4xl font-bold text-gray-900 mb-2">商品一覧</h2>
            <div class="w-24 h-1 bg-black"></div>
        </div>

        <!-- 商品グリッド -->
        <div class="grid grid-cols-4 gap-6">
            <!-- 商品カード1 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
                <div class="relative">
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                        <span class="text-gray-500 text-sm">商品画像A</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">ダミー商品A</h3>
                    <p class="text-2xl font-bold text-black mb-3">¥12,800</p>
                    <p class="text-gray-600 mb-4 line-clamp-2">これはダミーの商品Aの説明文です。商品の詳細な情報をここに記載します。</p>
                    <button class="w-full bg-black text-white font-medium py-3 px-4 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200">
                        詳細を見る
                    </button>
                </div>
            </div>

            <!-- 商品カード2 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
                <div class="relative">
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                        <span class="text-gray-500 text-sm">商品画像B</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">ダミー商品B (長めの名前)</h3>
                    <p class="text-2xl font-bold text-black mb-3">¥5,980</p>
                    <p class="text-gray-600 mb-4 line-clamp-2">機能性に優れた商品Bです。高品質な素材を使用しています。</p>
                    <button class="w-full bg-black text-white font-medium py-3 px-4 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200">
                        詳細を見る
                    </button>
                </div>
            </div>

            <!-- 商品カード3 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
                <div class="relative">
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                        <span class="text-gray-500 text-sm">商品画像C</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">ダミー商品C</h3>
                    <p class="text-2xl font-bold text-black mb-3">¥8,500</p>
                    <p class="text-gray-600 mb-4 line-clamp-2">人気の商品Cです。多くのお客様にご愛用いただいています。</p>
                    <button class="w-full bg-black text-white font-medium py-3 px-4 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200">
                        詳細を見る
                    </button>
                </div>
            </div>

            <!-- 商品カード4 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
                <div class="relative">
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                        <span class="text-gray-500 text-sm">商品画像D</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">ダミー商品D</h3>
                    <p class="text-2xl font-bold text-black mb-3">¥15,800</p>
                    <p class="text-gray-600 mb-4 line-clamp-2">プレミアムな商品Dです。特別な仕様でお作りしています。</p>
                    <button class="w-full bg-black text-white font-medium py-3 px-4 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200">
                        詳細を見る
                    </button>
                </div>
            </div>
        </div>

        <!-- もっと見るボタン -->
        <div class="text-center mt-12">
            <button class="bg-white text-black border-2 border-black font-medium py-3 px-8 rounded-md hover:bg-black hover:text-white focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 transition duration-200">
                もっと見る
            </button>
        </div>
    </main>

    <!-- フッター -->
    <footer class="bg-white border-t border-gray-200 mt-16">
        <div class="max-w-7xl mx-auto px-4 py-8">
            <div class="text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">TANITSUBO—YAMA</h3>
                <div class="flex justify-center space-x-8">
                    <a href="#" class="text-gray-600 hover:text-black transition duration-200">お問い合わせ</a>
                    <a href="#" class="text-gray-600 hover:text-black transition duration-200">利用規約</a>
                    <a href="#" class="text-gray-600 hover:text-black transition duration-200">プライバシーポリシー</a>
                </div>
                <p class="text-gray-500 text-sm mt-4">&copy; 2025 TANITSUBO-YAMA. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // 設定ドロップダウンの制御（Turbo対応）
        function initializeDropdown() {
            const dropdownButton = document.getElementById('settingsDropdownButton');
            const dropdown = document.getElementById('settingsDropdown');

            if (dropdownButton && dropdown) {
                // 既存のイベントリスナーを削除（重複防止）
                dropdownButton.removeEventListener('click', handleDropdownClick);
                
                // ドロップダウンボタンをクリック
                dropdownButton.addEventListener('click', handleDropdownClick);

                // ドロップダウン外をクリックで閉じる
                document.addEventListener('click', function(e) {
                    if (!dropdownButton.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.classList.add('hidden');
                    }
                });

                // ESCキーで閉じる
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        dropdown.classList.add('hidden');
                    }
                });
            }
        }

        function handleDropdownClick(e) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('settingsDropdown');
            if (dropdown) {
                dropdown.classList.toggle('hidden');
            }
        }

        // 初期読み込み時とTurbo読み込み時の両方で実行
        document.addEventListener('DOMContentLoaded', initializeDropdown);
        document.addEventListener('turbo:load', initializeDropdown);
        document.addEventListener('turbo:render', initializeDropdown);

        // 検索機能のプレースホルダー
        document.querySelector('input[type="text"]').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                alert('検索機能はバックエンドの実装が必要です');
            }
        });

        // ボタンクリックイベント
        document.querySelectorAll('button').forEach(button => {
            button.addEventListener('click', function(e) {
                if (this.textContent.includes('詳細を見る')) {
                    e.preventDefault();
                    alert('商品詳細ページはまだ実装されていません');
                } else if (this.textContent.includes('出品')) {
                    e.preventDefault();
                    alert('出品ページはまだ実装されていません');
                } else if (this.textContent.includes('もっと見る')) {
                    e.preventDefault();
                    alert('さらなる商品読み込み機能はバックエンドの実装が必要です');
                }
            });
        });

        // マイページと履歴のアラート
        document.querySelectorAll('a[href="#"]').forEach(link => {
            link.addEventListener('click', function(e) {
                if (this.textContent.includes('マイページ')) {
                    e.preventDefault();
                    alert('マイページはまだ実装されていません');
                } else if (this.textContent.includes('履歴')) {
                    e.preventDefault();
                    alert('履歴ページはまだ実装されていません');
                }
            });
        });
    </script>
</body>
</html>